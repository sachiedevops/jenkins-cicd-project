pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                echo 'GitHub source code will be checked out.'
            }
        }

        stage('Build') {
            steps {
                echo 'Building the application...'
            }
        }

        stage('Test') {
            steps {
                echo 'Testing the application...'
            }
        }
    }
}
